# ╔══════════════════════════════════════════════════════════════╗
# ║  ShopPilot AI — Production Environment Variables Template  ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# ─── Deployment Guide ─────────────────────────────────────────
#
# MongoDB Atlas:
#   1. Go to https://cloud.mongodb.com
#   2. Create a free M0 cluster
#   3. Database Access → Create user (readWrite access)
#   4. Network Access → Add IP (0.0.0.0/0 for all — or specific IPs)
#   5. Connection → Connect your application → Copy the URI
#
# Groq (AI):
#   1. Go to https://console.groq.com
#   2. Create API key
#   3. Copy the key (it won't be shown again)
#
# Cloudinary (Images):
#   1. Go to https://cloudinary.com
#   2. Sign up for free tier (25GB storage)
#   3. Dashboard → Copy cloud name, API key, API secret
#
# Vercel (Frontend):
#   1. Go to https://vercel.com
#   2. Import GitHub repo
#   3. Set environment variables in Vercel dashboard
#   4. Deploy
#
# Railway/Render (Backend):
#   1. Go to railway.app or render.com
#   2. Connect GitHub repo
#   3. Set root directory to server/
#   4. Set environment variables
#   5. Deploy

# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/shoppilot-ai?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-random-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# ─── AI (Groq) ───────────────────────────────────────────────
# Replace OpenAI with Groq for free, fast inference
# API format is OpenAI-compatible, so just swap the base URL
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Fallback to OpenAI if needed
# OPENAI_API_KEY=sk-your-openai-api-key

# ─── Cloudinary (Image Uploads) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── CORS ─────────────────────────────────────────────────────
# Your Vercel frontend URL (without trailing slash)
CORS_ORIGIN=https://your-app.vercel.app

# ─── Upload ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
